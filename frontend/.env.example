# Supabase — variables de entorno del frontend
# Copia este archivo a `.env` y completá los valores reales.
# NUNCA commitees `.env` (está en .gitignore). Si cambiás valores acá,
# el equipo debe actualizar su propio `.env` local.

# URL del proyecto Supabase (remoto o local)
# Remoto:  https://<project-ref>.supabase.co
# Local:   http://127.0.0.1:54321 (tras `supabase start`)
VITE_SUPABASE_URL=

# Anon key (pública por diseño, NO es la service_role key)
# Remoto:  Dashboard > Project Settings > API Keys > anon public
# Local:   `supabase status` -> Publishable key
VITE_SUPABASE_ANON_KEY=